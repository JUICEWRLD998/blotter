# Project-local npm settings. Scoped to blotter/ on purpose — the machine-wide
# ~/.npmrc points at registry.npmmirror.com with maxsockets=1, where every request
# took 12-17s and a cold install did not finish in 7 minutes.
#
# The official registry answers in well under a second from here (verified Phase 0).
registry=https://registry.npmjs.org/
maxsockets=8
